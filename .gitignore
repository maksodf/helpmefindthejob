# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Local environment + secrets — never commit
.env
.env.local
.env.production
.env.*.local
!.env.example
.deploy-env.local

# Local-only operator/submission docs — these carry personal email addresses and
# internal process notes; they must never be published. Kept on disk and shared
# with collaborators out of band, never committed.
Hallo.md

# Production data — sqlite DBs hold user accounts, hashed passwords, scan history.
# These live on the droplet and in WAL-aware snapshots, never in git.
data/

# escolib/data/ is packaged library reference data (a CC-BY-4.0 ESCO subset),
# NOT user data — it must ship with the package, so re-include it.
!escolib/data/
!escolib/data/**

# biasprobe/data/ is the standalone bias package's bundled copy of the caches
# (same synthetic-persona fixtures). Its parent biasprobe/ is not excluded, so —
# unlike data/bias_comparative_cache/ below — this negation works directly.
!biasprobe/data/
!biasprobe/data/**

# data/bias_comparative_cache/ holds committed model-response caches (synthetic-
# persona fit scores + model reasons + token/cost counts — NOT user data) that make
# the bias-methodology report replayable offline. They MUST ship so a stranger can
# reproduce the published bias numbers without API keys. The any-depth `data/` rule
# above cannot be selectively un-ignored without weakening PII protection for sibling
# data dirs (.venv/**/data, future nested data/), so these fixtures are force-tracked:
#   git add -f data/bias_comparative_cache/*.jsonl
# Add new provider caches the same way. tests/test_bias_comparative_runner.py asserts
# they stay git-tracked (CachesAreCommittedNotJustPresent), so a regression goes red.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.bak

# Backups directory (snapshots produced by pre-deploy-snapshot.sh)
backups/

# Email outbox + AI provider local config (per-host)
email_outbox.log
ai_providers.json
admin_audit.log

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Personal notes / drafts that happen to live in the repo dir
.obsidian/
.claude/
*.pdf
!docs/**/*.pdf

# Node (in case any tooling adds it later)
node_modules/

# mkdocs-material build output. Source for the docs site lives at
# `mkdocs.yml` + `docs/`; `site/` is generated by `mkdocs build` and
# is published to GitHub Pages by `.github/workflows/docs-publish.yml`.
# Committing the generated tree would create drift; the workflow
# always rebuilds from source.
site/

# Python virtual environment. Created by either the bare-host
# `pip install` workflow OR the `nix develop` flake bootstrap
# (see flake.nix). The environment is fully reproducible from
# requirements.txt + requirements-dev.txt; committing it would
# bloat the repo and create cross-platform drift.
.venv/

# Cosign signing material. Per the §4.2 signing-key-model
# decision (long-lived ECDSA P-256 / cosign model b), the
# private key + its password sidecar live OUTSIDE the repo at
# ~/.config/helpmefindthejob/. These ignore patterns are a
# defence-in-depth in case anyone runs `cosign generate-key-pair`
# at the repo root. The public key + signature bundle ARE
# committed under docs/releases/v0.1.0-cosign.pub +
# docs/releases/v0.1.0-source.tar.gz.sigstore — those are public.
cosign.key
cosign.password
*.cosign.key

# Source-tarball working copies (`gh release download v0.1.0`).
# The signed-and-released tarball lives in the GitHub Release; a
# local copy is regenerable from the tag at any time.
helpmefindthejob-*.tar.gz
# The immutable v0.1.0 sdist must keep its original filename —
# the cosign signature was computed over directjob-scout-0.1.0.tar.gz,
# so renaming would break verification.
directjob-scout-*.tar.gz

# axe-core CLI accessibility audit JSON output. Each file is 100–400 KB
# of axe-core's full rule trace (passes + violations + incomplete +
# inapplicable). The violation summary lives in ACCESSIBILITY.md;
# regeneration is one command (see ACCESSIBILITY.md "How to reproduce").
# Keeping these out of git avoids committing large generated artefacts
# that get stale on every code change.
audit-results/

# Compliance-page mirror — the canonical source for compliance/*.md
# is at the repo root. The mkdocs build hook at
# docs/hooks/compliance_mirror.py copies the two user-facing
# compliance pages into docs/compliance/ at build time so they
# render natively in the docs site. The mirror is regenerated on
# every build; committing it would create drift.
docs/compliance/

# Test artifacts
.tox/
.nox/

# Internal-only working docs relocated during the Week 1 grant-
# sprint sanitisation pass (docs/grant/02-execution-plan.md task 1.4).
# These are kept locally for reference but are not part of the public
# commons project. Add new internal-only docs under private/ rather
# than under docs/.
private/
.hypothesis/
.gstack/

# Local-only planning / strategy working files — never publish.
/WinningPlan.MD
/ProposedNGIFundedWork.MD
/Finalanswers.MD
/EXECUTION_PROMPT.md
/docs/grant/post-submission-state-*.md
