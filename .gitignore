# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Local environment + secrets — never commit
.env
.env.local
.env.production
.env.*.local
!.env.example
.deploy-env.local

# Production data — sqlite DBs hold user accounts, hashed passwords, scan history.
# These live on the droplet and in WAL-aware snapshots, never in git.
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.bak

# Backups directory (snapshots produced by pre-deploy-snapshot.sh)
backups/

# Email outbox + AI provider local config (per-host)
email_outbox.log
ai_providers.json
admin_audit.log

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Personal notes / drafts that happen to live in the repo dir
.obsidian/
.claude/
*.pdf
!docs/**/*.pdf

# Node (in case any tooling adds it later)
node_modules/

# mkdocs-material build output. Source for the docs site lives at
# `mkdocs.yml` + `docs/`; `site/` is generated by `mkdocs build` and
# is published to GitHub Pages by `.github/workflows/docs-publish.yml`.
# Committing the generated tree would create drift; the workflow
# always rebuilds from source.
site/

# axe-core CLI accessibility audit JSON output. Each file is 100–400 KB
# of axe-core's full rule trace (passes + violations + incomplete +
# inapplicable). The violation summary lives in ACCESSIBILITY.md;
# regeneration is one command (see ACCESSIBILITY.md "How to reproduce").
# Keeping these out of git avoids committing large generated artefacts
# that get stale on every code change.
audit-results/

# Test artifacts
.tox/
.nox/

# Internal / commercial-vision docs relocated during the Week 1 grant-
# sprint sanitisation pass (docs/grant/02-execution-plan.md task 1.4).
# These are kept locally for reference but are not part of the public
# commons project. Add new internal-only docs under private/ rather
# than under docs/.
private/
