# Helpmefindthejob — example environment file.
#
# Canonical env-var prefix is HELPMEFINDTHEJOB_*. Two legacy prefixes
# (DIRECTJOB_* from the pre-Decision-22 brand and COMPANY_DISCOVERY_*
# from the project's original name) are still read at runtime by the
# env_compat shim with a DeprecationWarning, so existing deployments
# do not break on this rename. The legacy prefixes are removed in
# Phase 3 — see docs/deployment-recipe.md for the migration path.
# Set every value you actually use under the new prefix; copy this
# file to .env and edit before running.

# Required for public deployment
HELPMEFINDTHEJOB_DOMAIN=scout.example.com
HELPMEFINDTHEJOB_SECRET_KEY=replace-with-output-of-python-secrets-token
HELPMEFINDTHEJOB_ADMIN_EMAIL=admin@example.com
HELPMEFINDTHEJOB_ADMIN_PASSWORD=replace-with-a-long-random-password
HELPMEFINDTHEJOB_PUBLIC_URL=https://scout.example.com

# Production hardening
HELPMEFINDTHEJOB_ENV=production
HELPMEFINDTHEJOB_COOKIE_SECURE=true
HELPMEFINDTHEJOB_ALLOW_REGISTRATION=false
# Email verification gate (Phase 3 #31). When true, unverified accounts
# cannot sign in until they click the link in the welcome email. Default
# false so existing test fixtures don't break; flip to true at launch.
HELPMEFINDTHEJOB_REQUIRE_EMAIL_VERIFICATION=false
HELPMEFINDTHEJOB_DATA_DIR=/app/data
HELPMEFINDTHEJOB_HOST=0.0.0.0
HELPMEFINDTHEJOB_PORT=8765

# Email delivery.
# Leave console for local/dev. Use smtp for real invites, reset links, and digests.
HELPMEFINDTHEJOB_EMAIL_BACKEND=console
# HELPMEFINDTHEJOB_EMAIL_BACKEND=smtp
# HELPMEFINDTHEJOB_SMTP_HOST=smtp.example.com
# HELPMEFINDTHEJOB_SMTP_PORT=587
# HELPMEFINDTHEJOB_SMTP_USERNAME=
# HELPMEFINDTHEJOB_SMTP_PASSWORD=
# HELPMEFINDTHEJOB_SMTP_STARTTLS=true
# HELPMEFINDTHEJOB_EMAIL_FROM=no-reply@scout.example.com

# Pilot quotas.
HELPMEFINDTHEJOB_QUOTA_SCANS_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_AI_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_DOMAIN_PER_HOUR=30
HELPMEFINDTHEJOB_QUOTA_ACTIVE_SCANS=3

# Billing.
# Manual billing is safe for the first pilot. Stripe Checkout needs live credentials.
HELPMEFINDTHEJOB_BILLING_BACKEND=manual
# HELPMEFINDTHEJOB_BILLING_BACKEND=stripe
# HELPMEFINDTHEJOB_STRIPE_API_KEY=
# HELPMEFINDTHEJOB_STRIPE_WEBHOOK_SECRET=
# HELPMEFINDTHEJOB_STRIPE_SUCCESS_URL=https://scout.example.com/billing/ok
# HELPMEFINDTHEJOB_STRIPE_CANCEL_URL=https://scout.example.com/billing/cancel
# B2C single-user plans (Phase 2 #21):
# HELPMEFINDTHEJOB_STRIPE_PRICE_PRO_MONTHLY=
# HELPMEFINDTHEJOB_STRIPE_PRICE_PRO_ANNUAL=
# B2B multi-seat plans (kept for the alternate sales motion):
# HELPMEFINDTHEJOB_STRIPE_PRICE_TEAM=
# HELPMEFINDTHEJOB_STRIPE_PRICE_ORG=

# Backup backend: local | rclone | s3 (via aws CLI). Off-host uploads
# require the matching binary on the host that runs the script.
# HELPMEFINDTHEJOB_BACKUP_BACKEND=local
# HELPMEFINDTHEJOB_BACKUP_BACKEND=rclone
# HELPMEFINDTHEJOB_BACKUP_REMOTE=remote:bucket/dj-scout
# HELPMEFINDTHEJOB_BACKUP_BACKEND=s3
# HELPMEFINDTHEJOB_BACKUP_REMOTE=s3://my-bucket/dj-scout
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30

# Operational visibility (recorded in /api/admin/readiness).
# Set when an external uptime / log shipping vendor is wired.
# HELPMEFINDTHEJOB_MONITORING_URL=https://uptime.betterstack.com/api/v3/monitors/...
# HELPMEFINDTHEJOB_LOG_TARGET=loki:3100/loki/api/v1/push

# Privacy-friendly analytics (Phase 7 #60). Optional. When unset, no
# third-party script loads. Self-host where possible (analytics.<your
# domain>) so the load is first-party from the user's perspective.
# HELPMEFINDTHEJOB_ANALYTICS_SCRIPT_URL=https://analytics.helpmefindthejob.com/js/script.js
# HELPMEFINDTHEJOB_ANALYTICS_DOMAIN=helpmefindthejob.com

# Legal readiness flag — set to "true" only after counsel reviews the
# /privacy /terms /data-retention pages.
# HELPMEFINDTHEJOB_LEGAL_REVIEWED=false

# Optional user-owned AI provider keys.
# The app stores only env var names in the UI, not raw secrets.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Managed AI (Phase 2 #26). When set, users on Pro+ plans can pick the
# "Managed AI" provider in Settings and the server will dispatch via
# the operator's key — no per-user API key needed. Plan-gated by
# Plan.ai_modes_allowed (#24/#25). Leave the key blank to keep
# Managed AI offline.
# HELPMEFINDTHEJOB_MANAGED_AI_PROVIDER=openai
# HELPMEFINDTHEJOB_MANAGED_AI_KEY=
# HELPMEFINDTHEJOB_MANAGED_AI_MODEL=gpt-4o-mini
# HELPMEFINDTHEJOB_MANAGED_AI_BASE_URL=
