# Required for public deployment
DIRECTJOB_DOMAIN=scout.example.com
DIRECTJOB_SECRET_KEY=replace-with-output-of-python-secrets-token
DIRECTJOB_ADMIN_EMAIL=admin@example.com
DIRECTJOB_ADMIN_PASSWORD=replace-with-a-long-random-password
DIRECTJOB_PUBLIC_URL=https://scout.example.com

# Production hardening
COMPANY_DISCOVERY_ENV=production
DIRECTJOB_COOKIE_SECURE=true
DIRECTJOB_ALLOW_REGISTRATION=false
COMPANY_DISCOVERY_DATA_DIR=/app/data
COMPANY_DISCOVERY_HOST=0.0.0.0
COMPANY_DISCOVERY_PORT=8765

# Email delivery.
# Leave console for local/dev. Use smtp for real invites, reset links, and digests.
DIRECTJOB_EMAIL_BACKEND=console
# DIRECTJOB_EMAIL_BACKEND=smtp
# DIRECTJOB_SMTP_HOST=smtp.example.com
# DIRECTJOB_SMTP_PORT=587
# DIRECTJOB_SMTP_USERNAME=
# DIRECTJOB_SMTP_PASSWORD=
# DIRECTJOB_SMTP_STARTTLS=true
# DIRECTJOB_EMAIL_FROM=no-reply@scout.example.com

# Pilot quotas.
DIRECTJOB_QUOTA_SCANS_PER_DAY=50
DIRECTJOB_QUOTA_AI_PER_DAY=50
DIRECTJOB_QUOTA_DOMAIN_PER_HOUR=30
DIRECTJOB_QUOTA_ACTIVE_SCANS=3

# Billing.
# Manual billing is safe for the first pilot. Stripe Checkout needs live credentials.
DIRECTJOB_BILLING_BACKEND=manual
# DIRECTJOB_BILLING_BACKEND=stripe
# DIRECTJOB_STRIPE_API_KEY=
# DIRECTJOB_STRIPE_PRICE_TEAM=
# DIRECTJOB_STRIPE_PRICE_ORG=
# DIRECTJOB_STRIPE_SUCCESS_URL=https://scout.example.com/billing/ok
# DIRECTJOB_STRIPE_CANCEL_URL=https://scout.example.com/billing/cancel

# Backup backend: local | rclone | s3 (via aws CLI). Off-host uploads
# require the matching binary on the host that runs the script.
# DIRECTJOB_BACKUP_BACKEND=local
# DIRECTJOB_BACKUP_BACKEND=rclone
# DIRECTJOB_BACKUP_REMOTE=remote:bucket/dj-scout
# DIRECTJOB_BACKUP_BACKEND=s3
# DIRECTJOB_BACKUP_REMOTE=s3://my-bucket/dj-scout
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30

# Operational visibility (recorded in /api/admin/readiness).
# Set when an external uptime / log shipping vendor is wired.
# DIRECTJOB_MONITORING_URL=https://uptime.betterstack.com/api/v3/monitors/...
# DIRECTJOB_LOG_TARGET=loki:3100/loki/api/v1/push

# Legal readiness flag — set to "true" only after counsel reviews the
# /privacy /terms /data-retention pages.
# DIRECTJOB_LEGAL_REVIEWED=false

# Optional user-owned AI provider keys.
# The app stores only env var names in the UI, not raw secrets.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
