# Fake env that flips every readiness signal to OK without using real
# credentials. Use it ONLY to verify the readiness checker itself:
#
#   ENV_FILE=deploy/readiness-fake.env ./scripts/production-readiness-check.sh
#
# This file MUST NOT be deployed. The "secrets" below are obvious
# fakes; the readiness script does not call any external service.
# The final flag makes runtime-created files (scheduler DB and audit log)
# pass in this fake, preflight-only check. Do not use that flag in
# production.

DIRECTJOB_DOMAIN=fake.example.com
DIRECTJOB_PUBLIC_URL=https://fake.example.com
DIRECTJOB_SECRET_KEY=fake-secret-key-with-enough-entropy-for-readiness-only
DIRECTJOB_ADMIN_EMAIL=admin@fake.example.com
DIRECTJOB_ADMIN_PASSWORD=fake-admin-password-not-real
COMPANY_DISCOVERY_ENV=production
DIRECTJOB_COOKIE_SECURE=true
DIRECTJOB_ALLOW_REGISTRATION=false
COMPANY_DISCOVERY_DATA_DIR=/tmp/dj-readiness-fake
DIRECTJOB_READINESS_ALLOW_UNINITIALIZED_RUNTIME=true

DIRECTJOB_EMAIL_BACKEND=smtp
DIRECTJOB_SMTP_HOST=smtp.fake.example.com
DIRECTJOB_SMTP_PORT=587
DIRECTJOB_SMTP_USERNAME=fake-user
DIRECTJOB_SMTP_PASSWORD=fake-password-not-real
DIRECTJOB_SMTP_STARTTLS=true
DIRECTJOB_EMAIL_FROM=no-reply@fake.example.com

DIRECTJOB_QUOTA_SCANS_PER_DAY=50
DIRECTJOB_QUOTA_AI_PER_DAY=50
DIRECTJOB_QUOTA_DOMAIN_PER_HOUR=30
DIRECTJOB_QUOTA_ACTIVE_SCANS=3

DIRECTJOB_BILLING_BACKEND=stripe
DIRECTJOB_STRIPE_API_KEY=sk_test_fake_readiness_only
DIRECTJOB_STRIPE_PRICE_TEAM=price_fake_team
DIRECTJOB_STRIPE_PRICE_ORG=price_fake_org
DIRECTJOB_STRIPE_SUCCESS_URL=https://fake.example.com/billing/ok
DIRECTJOB_STRIPE_CANCEL_URL=https://fake.example.com/billing/cancel

DIRECTJOB_BACKUP_BACKEND=rclone
DIRECTJOB_BACKUP_REMOTE=remote:fake-bucket/dj-scout
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

DIRECTJOB_MONITORING_URL=https://uptime.fake.example.com/api/v3/monitors/0000000
DIRECTJOB_LOG_TARGET=loki:3100/loki/api/v1/push
DIRECTJOB_LEGAL_REVIEWED=true
