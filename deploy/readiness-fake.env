# Fake env that flips every readiness signal to OK without using real
# credentials. Use it ONLY to verify the readiness checker itself:
#
#   ENV_FILE=deploy/readiness-fake.env ./scripts/production-readiness-check.sh
#
# This file MUST NOT be deployed. The "secrets" below are obvious
# fakes; the readiness script does not call any external service.
# The final flag makes runtime-created files (scheduler DB and audit log)
# pass in this fake, preflight-only check. Do not use that flag in
# production.

HELPMEFINDTHEJOB_DOMAIN=fake.example.com
HELPMEFINDTHEJOB_PUBLIC_URL=https://fake.example.com
HELPMEFINDTHEJOB_SECRET_KEY=fake-secret-key-with-enough-entropy-for-readiness-only
HELPMEFINDTHEJOB_ADMIN_EMAIL=admin@fake.example.com
HELPMEFINDTHEJOB_ADMIN_PASSWORD=fake-admin-password-not-real
HELPMEFINDTHEJOB_ENV=production
HELPMEFINDTHEJOB_COOKIE_SECURE=true
HELPMEFINDTHEJOB_ALLOW_REGISTRATION=false
HELPMEFINDTHEJOB_DATA_DIR=/tmp/dj-readiness-fake
HELPMEFINDTHEJOB_READINESS_ALLOW_UNINITIALIZED_RUNTIME=true

HELPMEFINDTHEJOB_EMAIL_BACKEND=smtp
HELPMEFINDTHEJOB_SMTP_HOST=smtp.fake.example.com
HELPMEFINDTHEJOB_SMTP_PORT=587
HELPMEFINDTHEJOB_SMTP_USERNAME=fake-user
HELPMEFINDTHEJOB_SMTP_PASSWORD=fake-password-not-real
HELPMEFINDTHEJOB_SMTP_STARTTLS=true
HELPMEFINDTHEJOB_EMAIL_FROM=no-reply@fake.example.com

HELPMEFINDTHEJOB_QUOTA_SCANS_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_AI_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_DOMAIN_PER_HOUR=30
HELPMEFINDTHEJOB_QUOTA_ACTIVE_SCANS=3


HELPMEFINDTHEJOB_BACKUP_BACKEND=rclone
HELPMEFINDTHEJOB_BACKUP_REMOTE=remote:fake-bucket/dj-scout
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

HELPMEFINDTHEJOB_MONITORING_URL=https://uptime.fake.example.com/api/v3/monitors/0000000
HELPMEFINDTHEJOB_LOG_TARGET=loki:3100/loki/api/v1/push
HELPMEFINDTHEJOB_LEGAL_REVIEWED=true
