# Helpmefindthejob - production .env template (placeholders only)
#
# Canonical env-var prefix is HELPMEFINDTHEJOB_*. Two legacy prefixes
# (HELPMEFINDTHEJOB_* from the pre-Decision-22 brand and HELPMEFINDTHEJOB_*
# from the project's original name) are still read at runtime by the
# env_compat shim with a DeprecationWarning, so an in-flight production
# deployment can migrate one variable at a time. The legacy prefixes
# are removed in Phase 3 — see docs/deployment-recipe.md migration path.
#
# Copy this file to /opt/helpmefindthejob/.env on the production host.
# Fill every blank value before deploy, then set owner root:root and
# mode 0600. Never commit the completed file.
#
# This template is shell-sourceable on purpose because
# scripts/production-readiness-check.sh loads it with:
#   ENV_FILE=/opt/helpmefindthejob/.env ./scripts/production-readiness-check.sh
#
# The unedited template should exit 2 from the readiness check. That is
# expected: it proves the script can read the file and report missing
# production inputs. Do not deploy until every required row is filled or
# deliberately accepted as partial.
#
# Never deploy deploy/readiness-fake.env. It is for offline readiness
# tests only and contains fake values.

############################################
# 1. Domain + crypto
############################################
# Example:
#   HELPMEFINDTHEJOB_DOMAIN=app.helpmefindthejob.com
#   HELPMEFINDTHEJOB_PUBLIC_URL=https://app.helpmefindthejob.com
HELPMEFINDTHEJOB_DOMAIN=
HELPMEFINDTHEJOB_PUBLIC_URL=

# Generate once with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HELPMEFINDTHEJOB_SECRET_KEY=

############################################
# 2. Initial admin
############################################
HELPMEFINDTHEJOB_ADMIN_EMAIL=
HELPMEFINDTHEJOB_ADMIN_PASSWORD=

############################################
# 3. Production hardening (do not change)
############################################
HELPMEFINDTHEJOB_ENV=production
HELPMEFINDTHEJOB_COOKIE_SECURE=true
HELPMEFINDTHEJOB_ALLOW_REGISTRATION=false
HELPMEFINDTHEJOB_DATA_DIR=/app/data
HELPMEFINDTHEJOB_HOST=0.0.0.0
HELPMEFINDTHEJOB_PORT=8765

############################################
# 4. Email (SMTP)
############################################
# With backend=console the app writes to data/email_outbox.log and
# sends nothing. Switch to smtp + fill the credentials before inviting
# external testers.
HELPMEFINDTHEJOB_EMAIL_BACKEND=smtp
HELPMEFINDTHEJOB_SMTP_HOST=
HELPMEFINDTHEJOB_SMTP_PORT=587
HELPMEFINDTHEJOB_SMTP_USERNAME=
HELPMEFINDTHEJOB_SMTP_PASSWORD=
HELPMEFINDTHEJOB_SMTP_STARTTLS=true
HELPMEFINDTHEJOB_EMAIL_FROM=

############################################
# 5. Quotas (env-tunable; defaults safe for pilot)
############################################
HELPMEFINDTHEJOB_QUOTA_SCANS_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_AI_PER_DAY=50
HELPMEFINDTHEJOB_QUOTA_DOMAIN_PER_HOUR=30
HELPMEFINDTHEJOB_QUOTA_ACTIVE_SCANS=3

############################################
# 6. Backups
############################################
# HELPMEFINDTHEJOB_BACKUP_BACKEND choices:
#   local   - pilot fallback; tarballs stay on the VPS
#   rclone  - off-host target configured in rclone
#   s3      - S3-compatible off-host target
#
# Set HELPMEFINDTHEJOB_BACKUP_REMOTE for rclone/s3, for example:
#   remote:helpmefindthejob/backups
#   s3://bucket-name/helpmefindthejob
HELPMEFINDTHEJOB_BACKUP_BACKEND=local
HELPMEFINDTHEJOB_BACKUP_REMOTE=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

############################################
# 7. Monitoring + log shipping
############################################
# These two values flip the monitoring readiness signal to OK. Use any
# vendor that can ping HTTPS and receive log lines.
HELPMEFINDTHEJOB_MONITORING_URL=
HELPMEFINDTHEJOB_LOG_TARGET=

############################################
# 8. Legal
############################################
# Flip to true only after counsel reviews:
#   static/privacy.html
#   static/terms.html
#   static/data-retention.html
HELPMEFINDTHEJOB_LEGAL_REVIEWED=false

############################################
# 9. Billing
############################################
# manual is the safe default for the pilot. Switch to stripe only after
# you have real Stripe credentials and price IDs.
HELPMEFINDTHEJOB_BILLING_BACKEND=manual
# HELPMEFINDTHEJOB_BILLING_BACKEND=stripe
# HELPMEFINDTHEJOB_STRIPE_API_KEY=
# HELPMEFINDTHEJOB_STRIPE_PRICE_TEAM=
# HELPMEFINDTHEJOB_STRIPE_PRICE_ORG=
# HELPMEFINDTHEJOB_STRIPE_SUCCESS_URL=https://app.helpmefindthejob.com/billing/ok
# HELPMEFINDTHEJOB_STRIPE_CANCEL_URL=https://app.helpmefindthejob.com/billing/cancel

############################################
# 10. Optional AI provider keys (server-side execution)
############################################
# Leave blank if every tester brings their own subscription. These are
# optional and should stay commented unless you deliberately want
# server-side AI execution.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

############################################
# 11. NEVER set this in production.
############################################
# This is a preflight-only readiness escape hatch used by
# deploy/readiness-fake.env.
# HELPMEFINDTHEJOB_READINESS_ALLOW_UNINITIALIZED_RUNTIME=
