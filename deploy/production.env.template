# DirectJob Scout - production .env template (placeholders only)
#
# Copy this file to /opt/directjob-scout/.env on the production host.
# Fill every blank value before deploy, then set owner root:root and
# mode 0600. Never commit the completed file.
#
# This template is shell-sourceable on purpose because
# scripts/production-readiness-check.sh loads it with:
#   ENV_FILE=/opt/directjob-scout/.env ./scripts/production-readiness-check.sh
#
# The unedited template should exit 2 from the readiness check. That is
# expected: it proves the script can read the file and report missing
# production inputs. Do not deploy until every required row is filled or
# deliberately accepted as partial.
#
# Never deploy deploy/readiness-fake.env. It is for offline readiness
# tests only and contains fake values.

############################################
# 1. Domain + crypto
############################################
# Example:
#   DIRECTJOB_DOMAIN=app.khalo.org
#   DIRECTJOB_PUBLIC_URL=https://app.khalo.org
DIRECTJOB_DOMAIN=
DIRECTJOB_PUBLIC_URL=

# Generate once with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DIRECTJOB_SECRET_KEY=

############################################
# 2. Initial admin
############################################
DIRECTJOB_ADMIN_EMAIL=
DIRECTJOB_ADMIN_PASSWORD=

############################################
# 3. Production hardening (do not change)
############################################
COMPANY_DISCOVERY_ENV=production
DIRECTJOB_COOKIE_SECURE=true
DIRECTJOB_ALLOW_REGISTRATION=false
COMPANY_DISCOVERY_DATA_DIR=/app/data
COMPANY_DISCOVERY_HOST=0.0.0.0
COMPANY_DISCOVERY_PORT=8765

############################################
# 4. Email (SMTP)
############################################
# With backend=console the app writes to data/email_outbox.log and
# sends nothing. Switch to smtp + fill the credentials before inviting
# external testers.
DIRECTJOB_EMAIL_BACKEND=smtp
DIRECTJOB_SMTP_HOST=
DIRECTJOB_SMTP_PORT=587
DIRECTJOB_SMTP_USERNAME=
DIRECTJOB_SMTP_PASSWORD=
DIRECTJOB_SMTP_STARTTLS=true
DIRECTJOB_EMAIL_FROM=

############################################
# 5. Quotas (env-tunable; defaults safe for pilot)
############################################
DIRECTJOB_QUOTA_SCANS_PER_DAY=50
DIRECTJOB_QUOTA_AI_PER_DAY=50
DIRECTJOB_QUOTA_DOMAIN_PER_HOUR=30
DIRECTJOB_QUOTA_ACTIVE_SCANS=3

############################################
# 6. Backups
############################################
# DIRECTJOB_BACKUP_BACKEND choices:
#   local   - pilot fallback; tarballs stay on the VPS
#   rclone  - off-host target configured in rclone
#   s3      - S3-compatible off-host target
#
# Set DIRECTJOB_BACKUP_REMOTE for rclone/s3, for example:
#   remote:directjob-scout/backups
#   s3://bucket-name/directjob-scout
DIRECTJOB_BACKUP_BACKEND=local
DIRECTJOB_BACKUP_REMOTE=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

############################################
# 7. Monitoring + log shipping
############################################
# These two values flip the monitoring readiness signal to OK. Use any
# vendor that can ping HTTPS and receive log lines.
DIRECTJOB_MONITORING_URL=
DIRECTJOB_LOG_TARGET=

############################################
# 8. Legal
############################################
# Flip to true only after counsel reviews:
#   static/privacy.html
#   static/terms.html
#   static/data-retention.html
DIRECTJOB_LEGAL_REVIEWED=false

############################################
# 9. Billing
############################################
# manual is the safe default for the pilot. Switch to stripe only after
# you have real Stripe credentials and price IDs.
DIRECTJOB_BILLING_BACKEND=manual
# DIRECTJOB_BILLING_BACKEND=stripe
# DIRECTJOB_STRIPE_API_KEY=
# DIRECTJOB_STRIPE_PRICE_TEAM=
# DIRECTJOB_STRIPE_PRICE_ORG=
# DIRECTJOB_STRIPE_SUCCESS_URL=https://app.khalo.org/billing/ok
# DIRECTJOB_STRIPE_CANCEL_URL=https://app.khalo.org/billing/cancel

############################################
# 10. Optional AI provider keys (server-side execution)
############################################
# Leave blank if every tester brings their own subscription. These are
# optional and should stay commented unless you deliberately want
# server-side AI execution.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

############################################
# 11. NEVER set this in production.
############################################
# This is a preflight-only readiness escape hatch used by
# deploy/readiness-fake.env.
# DIRECTJOB_READINESS_ALLOW_UNINITIALIZED_RUNTIME=
